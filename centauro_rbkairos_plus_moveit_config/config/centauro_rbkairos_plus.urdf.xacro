<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="centauro_rbkairos_plus">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import centauro_rbkairos_plus urdf file -->
    <xacro:include filename="$(find robotnik_description)/robots/rbkairos/centauro_centauro_rbkairos_plus.urdf.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="centauro_rbkairos_plus.ros2_control.xacro" />


    <xacro:centauro_rbkairos_plus_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
